DATABASE_URL=postgresql+asyncpg://openats:openats@localhost:5432/openats
# Local dev: already points at the `minio` service in docker-compose.yml
# (make setup starts it for you). In production, swap these for real
# Cloudflare R2 credentials or a self-hosted MinIO with TLS - the app code
# is identical either way (see app/shared/services/r2_service.py).
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=openats
R2_SECRET_ACCESS_KEY=openats12345
R2_BUCKET_NAME=openats
R2_PUBLIC_URL=http://localhost:9000/openats
# Only when storage is reached over a private network (e.g. self-hosted
# MinIO): the public host to sign resume URLs against. Defaults to R2_ENDPOINT.
R2_PUBLIC_ENDPOINT=
# How long a signed resume link stays valid, in seconds. Defaults to 900.
SIGNED_URL_TTL_SECONDS=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Self-hosted JWT auth (see app/shared/auth/jwt_auth.py). Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Multi-provider LLM gateway (app/shared/services/ai_gateway.py). Get a key
# at https://openrouter.ai/settings/keys.
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models - swap providers/models by
# changing this, never by changing code.
OPENROUTER_MODEL=google/gemini-2.5-flash
PORT=8080

GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
# Set to "true" only if the service account has Domain-Wide Delegation -
# otherwise attendee invites fail and events list attendees in the description.
GOOGLE_CALENDAR_ALLOW_ATTENDEES=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3000

REDIS_URL=redis://localhost:6379

# Optional. Requests per user per 15 minutes on the authenticated API.
# Defaults are 1000 for general routes and 60 for uploads.
RATE_LIMIT_API=1000
RATE_LIMIT_EXPENSIVE=60
