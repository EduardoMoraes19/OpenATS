# syntax=docker/dockerfile:1
#
# OpenATS backend (Python) — serves both the FastAPI+Socket.IO API
# (app.main:asgi_app) and the arq CV-analysis worker (app.worker_main). Same
# image, different command — mirrors Dockerfile.backend's "same image, two
# processes" rationale: they share every dependency, so building twice would
# only mean two chances to drift.

FROM python:3.12-slim AS base
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

# ---------- dependencies ----------
FROM base AS deps
COPY backend-py/pyproject.toml ./
RUN pip install --no-cache-dir .

# ---------- runtime ----------
FROM base AS runtime
RUN groupadd -r app && useradd -r -g app app

COPY --from=deps /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=deps /usr/local/bin /usr/local/bin
COPY backend-py ./backend-py
COPY docker-entrypoint-py.sh /usr/local/bin/docker-entrypoint-py.sh
RUN chmod +x /usr/local/bin/docker-entrypoint-py.sh

USER app
WORKDIR /app/backend-py
EXPOSE 8080

ENTRYPOINT ["docker-entrypoint-py.sh"]
CMD ["uvicorn", "app.main:asgi_app", "--host", "0.0.0.0", "--port", "8080"]
