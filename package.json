{
  "name": "openats",
  "private": true,
  "version": "0.5.0",
  "description": "OpenATS monorepo root - frontend/ is the only pnpm package; backend-py/ is a separate Python project orchestrated by the root Makefile (see `make dev`, `make test`)",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev:frontend": "pnpm --filter ./frontend dev",
    "build": "pnpm --filter ./frontend build",
    "lint": "pnpm --filter ./frontend lint",
    "test": "pnpm --filter ./frontend test:run",
    "test:watch": "pnpm --filter ./frontend test",
    "test:e2e": "playwright test",
    "test:frontend": "pnpm --filter ./frontend test:run"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.9.5",
    "concurrently": "^9.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "22.x"
  }
}
