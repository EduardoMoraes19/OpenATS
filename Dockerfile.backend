# syntax=docker/dockerfile:1
#
# OpenATS backend — serves both the Express API (dist/src/server.js) and the
# BullMQ CV-analysis worker (dist/src/worker.js). Same image, different command:
# the two processes share every dependency, so building twice would only mean
# two chances to drift.

FROM node:22-slim AS base
RUN corepack enable && corepack prepare pnpm@11.12.0 --activate
WORKDIR /app
ENV CI=1 NODE_ENV=production

# ---------- dependencies (including dev — tsc needs them) ----------
FROM base AS deps
ENV NODE_ENV=development
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
RUN pnpm install --frozen-lockfile --filter ./backend...

# ---------- compile TypeScript ----------
FROM deps AS build
COPY tsconfig.json ./
COPY backend ./backend
RUN pnpm --filter ./backend build

# ---------- runtime dependencies only ----------
FROM base AS prod-deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
RUN pnpm install --frozen-lockfile --prod --filter ./backend...

# ---------- runtime ----------
FROM node:22-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app

RUN groupadd -r app && useradd -r -g app app

COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=prod-deps /app/backend/node_modules ./backend/node_modules
COPY --from=build /app/backend/dist ./backend/dist
COPY backend/package.json ./backend/package.json
# Applied at boot by the entrypoint when RUN_MIGRATIONS=true
COPY backend/drizzle ./backend/drizzle
# swagger.ts reads this from process.cwd(), which is why WORKDIR is /app/backend
COPY backend/openapi.yaml ./backend/openapi.yaml
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

USER app
WORKDIR /app/backend
EXPOSE 8080

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["node", "dist/src/server.js"]
